# Copy to .env:  copy .env.example .env

BASEROW_URL=https://binnen-baserow.alsoknownas.me
BASEROW_TOKEN=your_database_token_here

# Brands table — from URL .../table/805/...
BRANDS_TABLE_ID=805

# productsDetails table (product rows) — ID 802. Table 806 is productCategory only.
PRODUCTS_TABLE_ID=802
CATEGORY_TABLE_ID=806
SUBCATEGORY_TABLE_ID=807

# Run: python discover_baserow.py  (prints field_XXXX for your table)
FIELD_BRAND_NAME=field_8323
FIELD_DOMAIN=field_8324
FIELD_BRAND_QUOTE=field_8325
FIELD_PRODUCTS=field_8326
FIELD_BG_REMOVE=field_8328

# productsDetails columns (table 802)
FIELD_PRODUCT_NAME=field_8224
FIELD_PRODUCT_DESCRIPTION=field_8225
FIELD_PRODUCT_URL=field_8229
FIELD_PRODUCT_STATUS=field_8230
FIELD_DESIGNER=field_8233
FIELD_DESIGNER_DESCRIPTION=field_8234
FIELD_DESIGNER_IMAGE=field_8232
FIELD_SOURCE_CATEGORY=field_8245
FIELD_SOURCE_SUBCATEGORY=field_8246
FIELD_PRICE=field_8248
FIELD_PRODUCT_CATEGORY=field_8240
FIELD_SUB_CATEGORY=field_8241
FIELD_BRAND_LINK=field_8253
FIELD_PRODUCT_IMAGES=field_8226
FIELD_HERO_IMAGES=field_8235
FIELD_LIFESTYLE_IMAGES=field_8236
FIELD_DETAIL_IMAGE=field_8237
UPLOAD_PRODUCT_IMAGES=true
# 0 = upload all scraped images (no limit)
MAX_PRODUCT_IMAGES_UPLOAD=0
MAX_LIFESTYLE_IMAGES_UPLOAD=0

# productCategory / subCategory lookup tables
FIELD_CATEGORY_NAME=field_8329
FIELD_SUBCATEGORY_NAME=field_8333
FIELD_SUBCATEGORY_PARENT=field_8334

# Optional extra URL column (leave empty if using FIELD_DOMAIN only)
FIELD_WEBSITE_URL=

# No scrape_status column in your table — leave these empty:
FIELD_SCRAPE_STATUS=
FIELD_SCRAPE_ERROR=
FIELD_LAST_SCRAPED=
FIELD_PAGE_TITLE=
FIELD_META_DESCRIPTION=

# Filters (no status column needed)
# Skip brands that already have a note in "Brand quote" (IP block, offline, etc.)
SKIP_IF_BRAND_QUOTE=true
# Only scrape rows where bg_remove is checked
SCRAPE_ONLY_BG_REMOVE=false
# Skip if productsDetails already has linked products
SKIP_IF_HAS_PRODUCTS=false

SCRAPE_DELAY_SECONDS=2
HTTP_TIMEOUT=30

# OpenRouter — on --save: original → product_description, AI rewrite → ai_description_translated_NL
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PRODUCT_DESCRIPTIONS=false
FIELD_AI_DESCRIPTION_NL=field_8239
FIELD_ACCORDION_PRODUCT_DESCRIPTION=field_8287

# Shopify — draft products with lifestyle/background images
# shopify_draft_bg_products.py
SHOPIFY_SHOP=ddvwt8-0k
SHOPIFY_CLIENT_ID=your_app_client_id
SHOPIFY_CLIENT_SECRET=your_app_client_secret
# Optional: legacy custom app token (skips client-credentials flow)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_DRAFT_WORKERS=20

# baserow_shopify_sync.py — Shopify product metafields (namespace custom by default)
SHOPIFY_METAFIELD_NAMESPACE=custom
SHOPIFY_METAFIELD_CATEGORY=product_category
SHOPIFY_METAFIELD_SUB_CATEGORY=sub_category
SHOPIFY_METAFIELD_LIFESTYLE_IMAGES=lifestyle_images
SHOPIFY_METAFIELD_DESIGNER=designer
SHOPIFY_METAFIELD_DESIGNER_IMAGE=designer_image

# Pixelbin erase.bg — background removal (shopify_pixelbin_remove_bg.py)
# Console: Settings -> Tokens -> Create Token (NOT your login password)
PIXELBIN_API_TOKEN=your_pixelbin_api_token_here
PIXELBIN_API_DOMAIN=https://api.pixelbin.io
PIXELBIN_INDUSTRY_TYPE=ecommerce
PIXELBIN_QUALITY_TYPE=original
PIXELBIN_REFINE=true
PIXELBIN_SHADOW=false
PIXELBIN_HTTP_TIMEOUT=120
