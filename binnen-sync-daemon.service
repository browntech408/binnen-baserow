[Unit]
Description=Binnen Catalog OS - Continuous 10s Baserow to Shopify Auto-Sync Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/binnen/app
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/binnen/app/.env
ExecStart=/home/binnen/app/.venv/bin/python -u /home/binnen/app/sync_daemon.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
