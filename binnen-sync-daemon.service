[Unit]
Description=Binnen Catalog OS - Continuous 10s Baserow to Shopify Auto-Sync Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/binnen/app
ExecStart=/home/binnen/app/.venv/bin/python /home/binnen/app/sync_daemon.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
