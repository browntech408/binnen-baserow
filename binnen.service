[Unit]
Description=Binnen Catalog OS - FastAPI Dashboard
After=network.target

[Service]
Type=simple
User=binnen
WorkingDirectory=/home/binnen/app
Environment="PATH=/home/binnen/app/.venv/bin"
EnvironmentFile=/home/binnen/app/.env
ExecStart=/home/binnen/app/.venv/bin/uvicorn dashboard.server:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
